<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FormularioUsandoGrid.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Formulario">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!--  Título  -->
            <Label
                FontAttributes="Bold"
                FontSize="14"
                HorizontalOptions="Center"
                Text="Unidad 2. Actividad 2:"
                TextColor="#16d0f5" />

            <Label
    FontAttributes="Bold"
    FontSize="28"
    HorizontalOptions="Center"
    Text="Formulario de Registro"
    TextColor="#1E88E5" />

            <!--  Grid del formulario  -->
            <Grid ColumnSpacing="10" RowSpacing="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Nombre  -->
                <Label Grid.Row="0" Text="Nombre" />
                <Entry
                    x:Name="txtNombre"
                    Grid.Row="1"
                    Placeholder="Ingrese su nombre" />

                <!--  Email  -->
                <Label Grid.Row="2" Text="Correo" />
                <Entry
                    x:Name="txtEmail"
                    Grid.Row="3"
                    Keyboard="Email"
                    Placeholder="Ingrese su correo" />

                <!--  Género  -->
                <Label Grid.Row="4" Text="Género" />
                <Picker x:Name="pickerGenero" Grid.Row="5">
                    <Picker.Items>
                        <x:String>Masculino</x:String>
                        <x:String>Femenino</x:String>
                        <x:String>Otro</x:String>
                    </Picker.Items>
                </Picker>

                <!--  Fecha  -->
                <Label Grid.Row="6" Text="Fecha de Nacimiento" />
                <DatePicker x:Name="dateNacimiento" Grid.Row="7" />

                <!--  Checkbox  -->
                <HorizontalStackLayout Grid.Row="8" Spacing="10">
                    <CheckBox x:Name="chkTerminos" />
                    <Label Text="Aceptar términos y condiciones" VerticalOptions="Center" />
                </HorizontalStackLayout>

            </Grid>

            <!--  Botón fuera del Grid (mejor práctica)  -->
            <Button
                BackgroundColor="#1E88E5"
                Clicked="OnEnviarClicked"
                Text="Enviar"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>


